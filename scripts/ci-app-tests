#!/bin/bash
# Test the app and iOS Keychain attributes, optionally reusing a shared build.
set -euo pipefail
APP_RESULTS="${1:?usage: ci-app-tests <fresh-results-directory> [--skip-build]}"
APP_TEST_ACTION=test
case "${2:-}" in
  "") ;;
  --skip-build)
    : "${SIMULATOR_ID:?--skip-build requires SIMULATOR_ID}"
    : "${DERIVED_DATA:?--skip-build requires DERIVED_DATA}"
    APP_TEST_ACTION=test-without-building
    ;;
  *) echo "usage: ci-app-tests <fresh-results-directory> [--skip-build]" >&2; exit 2 ;;
esac
[[ $# -le 2 ]] || { echo "too many arguments" >&2; exit 2; }
mkdir -p "$APP_RESULTS"
APP_SIMULATOR_ID="${SIMULATOR_ID:-$(scripts/ios-simulator iPhone)}"
APP_DERIVED_DATA="${DERIVED_DATA:-$APP_RESULTS/DerivedData}"
if [[ "$APP_TEST_ACTION" == test-without-building ]]; then
  shopt -s nullglob
  specs=("$APP_DERIVED_DATA"/Build/Products/WinnowApp_*.xctestrun)
  [[ ${#specs[@]} == 1 ]] || { echo 'Expected exactly one app test specification' >&2; exit 1; }
  # The run's coverage profile lands in this DerivedData for ci-crap.
  args=(-xctestrun "${specs[0]}" -derivedDataPath "$APP_DERIVED_DATA")
else
  args=(-project WinnowApp.xcodeproj -scheme WinnowApp -configuration Debug
        -derivedDataPath "$APP_DERIVED_DATA" -skipPackagePluginValidation -skipMacroValidation)
fi
# WINNOW_APP_CODE_COVERAGE=YES keeps executable-line coverage in the result
# bundle for the CRAP gate (scripts/ci-crap export-app).
xcodebuild "$APP_TEST_ACTION" "${args[@]}" \
  -destination "platform=iOS Simulator,id=$APP_SIMULATOR_ID" \
  -enableCodeCoverage "${WINNOW_APP_CODE_COVERAGE:-NO}" \
  -resultBundlePath "$APP_RESULTS/AppTests.xcresult" \
  -only-testing:WinnowAppTests \
  2>&1 | tee "$APP_RESULTS/app-tests.log"
