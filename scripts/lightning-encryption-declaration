#!/usr/bin/env python3
"""Set the Winnow Lightning target's export compliance keys for a release.

LIGHTNING_NONEXEMPT_ENCRYPTION is the account holder's reviewed answer:
PENDING (default) removes the key so App Store Connect asks its questions;
YES keeps it and adds LIGHTNING_ENCRYPTION_COMPLIANCE_CODE; NO sets it to NO.
Only the WinnowLightning target changes; the ordinary app keeps its own.
"""
import os
from pathlib import Path
import re
import sys

KEY = 'INFOPLIST_KEY_ITSAppUsesNonExemptEncryption'


def declare(text, mode, code=None):
    head, rest = text.split('\n  WinnowLightning:\n', 1)
    target, tail = re.split(r'\n(?=  [A-Za-z]+:\n)', rest, maxsplit=1)
    line = re.search(rf'\n(\s*){KEY}: YES', target)
    if not line:
        raise SystemExit('WinnowLightning does not declare non-exempt encryption')
    indent = line.group(1)
    if mode == 'PENDING':
        replacement = ''
    elif mode == 'YES':
        if not code:
            raise SystemExit('YES needs LIGHTNING_ENCRYPTION_COMPLIANCE_CODE')
        replacement = f'\n{indent}{KEY}: YES\n{indent}INFOPLIST_KEY_ITSEncryptionExportComplianceCode: "{code}"'
    elif mode == 'NO':
        replacement = f'\n{indent}{KEY}: NO'
    else:
        raise SystemExit('LIGHTNING_NONEXEMPT_ENCRYPTION must be PENDING, YES or NO')
    target = target[:line.start()] + replacement + target[line.end():]
    return head + '\n  WinnowLightning:\n' + target + '\n' + tail


def main():
    path = Path(sys.argv[1])
    mode = os.environ.get('LIGHTNING_NONEXEMPT_ENCRYPTION', 'PENDING')
    path.write_text(declare(path.read_text(), mode, os.environ.get('LIGHTNING_ENCRYPTION_COMPLIANCE_CODE')))
    print(f'WinnowLightning export compliance: {mode}')


if __name__ == '__main__':
    main()
