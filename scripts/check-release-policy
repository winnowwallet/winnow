#!/usr/bin/env python3
"""Validate a stable version and the actual bundled peer generation date."""
import datetime as dt
import os
import pathlib
import re

tag = os.environ.get('RELEASE_TAG', '')
if tag and not re.fullmatch(r'v(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)', tag):
    raise SystemExit('expected a stable vMAJOR.MINOR.PATCH tag')
text = pathlib.Path('Sources/WalletCore/Network/Protocol/FallbackPeersGenerated.swift').read_text()
match = re.search(r'^// Generation: ([^,]+),', text, re.M)
if not match:
    raise SystemExit('fallback peers have no recorded generation date')
generated = dt.datetime.fromisoformat(match[1].replace('Z', '+00:00'))
age = (dt.datetime.now(dt.timezone.utc) - generated).total_seconds() / 86400
print(f'fallback peers generated {match[1]} ({age:.1f} days ago)')
observation = re.search(r'^// Observation date: (\d{4}-\d{2}-\d{2}); generated:', text, re.M)
if 'winnow-census artifact of ' in text and not observation:
    raise SystemExit('legacy census bundle has no source hash/observation provenance; regenerate it')
if observation:
    if not re.search(r'^// Source SHA256: [0-9a-f]{64}$', text, re.M):
        raise SystemExit('census provenance has no valid source SHA256')
    if not re.search(r'^// Source commit: [0-9a-f]{40}$', text, re.M):
        raise SystemExit('census provenance names no census commit; regenerate with --census-commit')
    observed = dt.date.fromisoformat(observation[1])
    observation_age = (dt.datetime.now(dt.timezone.utc).date() - observed).days
    if not 0 <= observation_age <= 7:
        raise SystemExit('census observation is future-dated or older than seven days')
if not 0 <= age <= (8 if observation else 30):
    raise SystemExit('run scripts/generate-fallback-peers and commit the refreshed list before tagging')
