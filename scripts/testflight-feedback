#!/usr/bin/env python3
"""Pull TestFlight feedback for Winnow into a directory.

Screenshot feedback (comments and images) and crash feedback (with crash logs)
come from the App Store Connect API as raw JSON, with images and logs beside
them. Tester comments, email addresses and device details are personal data:
this prints counts only, and the workflow encrypts the directory before it
leaves the runner. Needs ASC_KEY_PATH, ASC_KEY_ID and ASC_ISSUER_ID.
"""
import argparse
import json
import os
import pathlib
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

API = "https://api.appstoreconnect.apple.com/v1"
BUNDLE_ID = "com.btcswift.app"
KINDS = ("betaFeedbackScreenshotSubmissions", "betaFeedbackCrashSubmissions")


def token():
    args = [os.environ[name] for name in ("ASC_KEY_PATH", "ASC_KEY_ID", "ASC_ISSUER_ID")]
    return subprocess.run(["swift", "scripts/asc-jwt.swift", *args], check=True,
                          capture_output=True, text=True).stdout.strip()


def get(url, bearer, raw=False):
    request = urllib.request.Request(url, headers={"Authorization": f"Bearer {bearer}"} if bearer else {})
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            body = response.read()
    except urllib.error.HTTPError as error:
        # Apple's error titles and codes carry no tester data.
        detail = ""
        try:
            first = json.loads(error.read())["errors"][0]
            detail = f": {first.get('code')} {first.get('title')}"
        except (ValueError, KeyError, IndexError):
            pass
        raise SystemExit(f"HTTP {error.code} for {urllib.parse.urlsplit(url).path}{detail}")
    return body if raw else json.loads(body)


def pages(url, bearer, limit):
    items, included = [], []
    while url and len(items) < limit:
        page = get(url, bearer)
        items += page.get("data", [])
        included += page.get("included", [])
        url = page.get("links", {}).get("next")
    return items[:limit], included


def image_url(asset):
    if asset.get("url"):
        return asset["url"]
    template = asset.get("templateUrl")
    if template:
        return template.replace("{w}", str(asset.get("width", 1290))) \
                       .replace("{h}", str(asset.get("height", 2796))).replace("{f}", "png")
    return None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("out", type=pathlib.Path)
    parser.add_argument("--limit", type=int, default=50, help="newest submissions of each kind")
    args = parser.parse_args()
    args.out.mkdir(parents=True, exist_ok=False)
    bearer = token()
    apps = get(f"{API}/apps?filter[bundleId]={BUNDLE_ID}", bearer)["data"]
    if not apps:
        raise SystemExit(f"no App Store Connect app for {BUNDLE_ID}")
    app = apps[0]["id"]
    summary = {}
    for kind in KINDS:
        page_size = min(args.limit, 200)
        query = urllib.parse.urlencode({"limit": page_size, "sort": "-createdDate", "include": "build"})
        try:
            items, included = pages(f"{API}/apps/{app}/{kind}?{query}", bearer, args.limit)
        except SystemExit as error:
            if not str(error).startswith("HTTP 400"):
                raise
            # Not every feedback listing accepts sorting or includes.
            items, included = pages(f"{API}/apps/{app}/{kind}?limit={page_size}", bearer, args.limit)
        (args.out / f"{kind}.json").write_text(json.dumps({"data": items, "included": included}, indent=2))
        files = 0
        for item in items:
            folder = args.out / kind / item["id"]
            folder.mkdir(parents=True)
            if kind == "betaFeedbackCrashSubmissions":
                try:
                    log = get(f"{API}/{kind}/{item['id']}/crashLog", bearer)
                    (folder / "crashLog.json").write_text(json.dumps(log, indent=2))
                    files += 1
                except SystemExit as error:
                    (folder / "crashLog.error").write_text(str(error))
            for index, asset in enumerate(item.get("attributes", {}).get("screenshots") or []):
                url = image_url(asset)
                if not url:
                    continue
                try:
                    (folder / f"screenshot-{index}.png").write_bytes(get(url, None, raw=True))
                    files += 1
                except SystemExit as error:
                    (folder / f"screenshot-{index}.error").write_text(str(error))
        summary[kind] = {"submissions": len(items), "files": files}
    (args.out / "summary.json").write_text(json.dumps(summary, indent=2))
    for kind, counts in summary.items():
        print(f"{kind}: {counts['submissions']} submissions, {counts['files']} files")


if __name__ == "__main__":
    sys.exit(main())
