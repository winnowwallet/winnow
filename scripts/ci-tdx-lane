#!/bin/bash
# Runs only inside a disposable tdx macOS guest; never on a developer machine.
set -euo pipefail
lane=${1:?package|build|units|journey}
[[ $(uname -m) == x86_64 && -f /etc/winnow-ci-image ]]
grep -qx tdx-macos15.7.9-xcode26.6-17F113-v1 /etc/winnow-ci-image
xcodebuild -version | grep -q 'Build version 17F113'
xcrun simctl list runtimes | grep -q 'iOS 26.5 (26.5 - 23F77)'
export PATH=/usr/local/opt/python@3.12/libexec/bin:/usr/local/bin:$PATH
ROOT=$PWD
export CI_RESULTS=/Users/macdev/winnow-ci/results
export DERIVED_DATA=/Users/macdev/winnow-ci/build
export APP_RESULTS=$CI_RESULTS/app
export WINNOW_NODE_HOST=127.0.0.1 WINNOW_RPC_PORT=38600 WINNOW_P2P_PORT=38601
mkdir -p "$APP_RESULTS" "$CI_RESULTS/lanes"
start=$SECONDS
phase() { printf '{"lane":"%s","phase":"%s","elapsed_seconds":%s}\n' "$lane" "$1" "$((SECONDS-start))" >> "$CI_RESULTS/$lane-timings.log"; }
phase started
finish() {
  result=$?
  phase finished
  trap - EXIT
  if [[ $lane == journey ]]; then
    scripts/signet-fixture down > /dev/null 2>&1 || true
    rm -f "$HOME/.winnow-node.env"
  fi
  if [[ $lane == units || $lane == journey ]]; then xcrun simctl shutdown all || true; fi
  python3 - "$lane" "$result" "$((SECONDS-start))" "$CI_RESULTS" <<'PY'
import json,pathlib,re,subprocess,sys
lane,code,elapsed,root=sys.argv[1:];root=pathlib.Path(root)
logs='\n'.join(p.read_text(errors='replace') for p in root.rglob('*.log'))
patterns={'package':r'Test run with (\d+) tests', 'units':r'Executed (\d+) tests', 'journey':r"test01CreateReceiveSendConfirm\]' passed"}
if lane=='journey': count=int(bool(re.search(patterns[lane],logs)))
elif lane=='build':count=0
else: count=max([int(n) for n in re.findall(patterns[lane],logs)]+[0])
if lane=='units':count+=max([int(n) for n in re.findall(r'Test run with (\d+) tests',logs)]+[0])
inventory=sorted(set(re.findall(r"Test Case '([^']+)' passed",logs)+re.findall(r'✔ Test (.+?) passed',logs)))
checksum=root/'debug-transfer/debug.tar.sha256'
build_hash=checksum.read_text().split()[0] if checksum.is_file() else None
source=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()
(root/'lanes'/f'{lane}.json').write_text(json.dumps({'source_sha':source,'debug_sha256':build_hash,'result':'success' if code=='0' else 'failure','tests':count,'elapsed_seconds':int(elapsed),'phases':[json.loads(line) for line in (root/f'{lane}-timings.log').read_text().splitlines()],'inventory':inventory,'runtime':'iOS 26.5 (23F77)','architecture':'x86_64','image':pathlib.Path('/etc/winnow-ci-image').read_text().strip()}))
PY
  exit "$result"
}
trap finish EXIT
wait_build() {
  deadline=$((SECONDS+900))
  name="tdx-debug-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
  while (( SECONDS < deadline )); do
    id=$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID/artifacts" --jq ".artifacts[] | select(.name == \"$name\" and .expired == false) | .id")
    if [[ -n $id ]]; then
      mkdir -p "$CI_RESULTS/debug-transfer"
      gh run download "$GITHUB_RUN_ID" -R "$GITHUB_REPOSITORY" -n "$name" -D "$CI_RESULTS/debug-transfer"
      (cd "$CI_RESULTS/debug-transfer" && shasum -a 256 -c debug.tar.sha256)
      tar -xf "$CI_RESULTS/debug-transfer/debug.tar" -C /Users/macdev/winnow-ci
      return
    fi
    sleep 5
  done
  echo 'Shared Debug artifact did not arrive within 15 minutes' >&2; return 1
}
boot_simulator() {
  phase simulator-boot-request
  xcrun simctl boot "$SIMULATOR_ID" || true
  (xcrun simctl bootstatus "$SIMULATOR_ID" -b > "$CI_RESULTS/simulator.log" 2>&1; phase simulator-ready) &
  simulator_boot_pid=$!
}
case "$lane" in
 package)
  swiftlint lint --quiet
  scripts/check-test-gates
  scripts/check-dependencies
  phase package-tests-start
  swift test 2>&1 | tee "$CI_RESULTS/package.log"
  phase package-tests-finished
  scripts/ci-debug
  scripts/ci-production-warnings "$CI_RESULTS/production-build" "$CI_RESULTS/production-build.log"
  for command in inspect generate soak; do "$CI_RESULTS/production-build/release/winnow-debug" "$command" --help; done
  swift run --scratch-path "$CI_RESULTS/production-build" -c release WinnowFuzz --iterations 1000 --seed 0x57494e4e4f575055 --max-input 16384 --artifact-dir "$CI_RESULTS/fuzz" 2>&1 | tee "$CI_RESULTS/fuzz.log"
  for dir in supply-chain supply-chain-replay; do
    scripts/generate-supply-chain-metadata --output-dir "$CI_RESULTS/$dir" --subject "$CI_RESULTS/production-build/release/winnow-debug" --subject-name winnow-debug --builder-id "https://github.com/$GITHUB_REPOSITORY/.github/workflows/ci-tdx.yml@$GITHUB_SHA"
  done
  diff -ru "$CI_RESULTS/supply-chain" "$CI_RESULTS/supply-chain-replay"
 ;;
 build)
  scripts/install-xcodegen
  export PATH="$RUNNER_TEMP/winnow-xcodegen-2.46.0/xcodegen/bin:$PATH"
  xcodegen
  export SIMULATOR_ID=$(scripts/ios-simulator iPhone)
  phase compilation-start
  xcodebuild build-for-testing -project WinnowApp.xcodeproj -scheme WinnowApp -configuration Debug -destination "platform=iOS Simulator,id=$SIMULATOR_ID" -derivedDataPath "$DERIVED_DATA" -skipPackagePluginValidation -skipMacroValidation 2>&1 | tee "$APP_RESULTS/debug-build.log"
  phase compilation-finished
  scripts/check-dependencies --xcode "$DERIVED_DATA"
  mkdir -p "$CI_RESULTS/debug-transfer"
  tar -cf "$CI_RESULTS/debug-transfer/debug.tar" -C /Users/macdev/winnow-ci build/Build/Products
  (cd "$CI_RESULTS/debug-transfer" && shasum -a 256 debug.tar > debug.tar.sha256)
 ;;
 units)
  export SIMULATOR_ID=$(scripts/ios-simulator iPhone)
  boot_simulator
  phase artifact-wait-start
  wait_build
  phase artifact-ready
  wait "$simulator_boot_pid"
  phase tests-start
  scripts/ci-app-tests "$APP_RESULTS/units" --skip-build
 ;;
 journey)
  export SIMULATOR_ID=$(scripts/ios-simulator iPhone)
  boot_simulator
  export WINNOW_DATADIR="$APP_RESULTS/signet"
  [[ ! -e $WINNOW_DATADIR ]]
  phase fixture-start
  scripts/signet-fixture up
  swift build --product winnow-fixture
  export WINNOW_FIXTURE_EXECUTABLE="$ROOT/.build/debug/winnow-fixture"
  "$WINNOW_FIXTURE_EXECUTABLE" prepare-bank 2>&1 | tee "$CI_RESULTS/fixture.log"
  phase fixture-ready
  mkdir -p "$APP_RESULTS/journey/node-screenshots"
  printf 'WINNOW_NODE_HOST=%s\nWINNOW_P2P_PORT=%s\nWINNOW_RPC_PORT=%s\nWINNOW_DATADIR=%s\nWINNOW_SCREENSHOT_DIR=%s\n' "$WINNOW_NODE_HOST" "$WINNOW_P2P_PORT" "$WINNOW_RPC_PORT" "$WINNOW_DATADIR" "$APP_RESULTS/journey/node-screenshots" > "$HOME/.winnow-node.env"
  phase artifact-wait-start
  wait_build
  phase artifact-ready
  wait "$simulator_boot_pid"
  phase tests-start
  scripts/ci-deadline 900 scripts/ci-ui-journey "$APP_RESULTS/journey" --skip-build
  phase tests-finished
  scripts/prepare-site-artifact --normalize-journey "$APP_RESULTS/journey" --media-output "$CI_RESULTS/media"
  phase media-ready
 ;;
 *) exit 2 ;;
esac
