#!/usr/bin/env python3
"""Require the local first-party package and no third-party resolutions.

The app, tools and tests build from this checkout alone: the manifest declares
no dependencies, SwiftPM writes no lockfile (it removes Package.resolved for a
package without pins), project.yml references only the local package, and an
Xcode build directory, when given, resolved no source-control package.
"""
import argparse
import json
import pathlib
import re
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--xcode', type=pathlib.Path, metavar='DERIVED_DATA')
args = parser.parse_args()
root = pathlib.Path(__file__).resolve().parent.parent
project = (root / 'project.yml').read_text()
if not re.search(r'^  Winnow:\n    path: \.\s*$', project, re.M):
    raise SystemExit('the app must consume the root package locally')
packages = re.search(r'^packages:\n(.*?)(?=^\S)', project, re.M | re.S)
if not packages or re.findall(r'^  (\S+):\s*$', packages.group(1), re.M) != ['Winnow'] \
        or re.search(r'^\s+(url|github):', packages.group(1), re.M):
    raise SystemExit('project.yml must reference only the local Winnow package')

def manifest(path):
    return json.loads(subprocess.check_output(
        ['swift', 'package', '--package-path', str(path), 'dump-package'], text=True))

def pins(path):
    return {p['identity']: (p['location'], p['state'])
            for p in json.loads(path.read_text())['pins']}

if manifest(root)['dependencies']:
    raise SystemExit('the root manifest declares a dependency; review the monorepo dependency policy')
resolved = root / 'Package.resolved'
if resolved.exists() and pins(resolved):
    raise SystemExit('Package.resolved pins a package; review the monorepo dependency policy')
if args.xcode:
    # Xcode records every resolved package of a build in its workspace state.
    # Local packages appear there without a checkout; any source-control
    # checkout is a dependency this policy forbids.
    if not args.xcode.is_dir():
        raise SystemExit(f'no Xcode build directory at {args.xcode}')
    path = args.xcode / 'SourcePackages/workspace-state.json'
    checkouts = {}
    if path.exists():
        dependencies = json.loads(path.read_text())['object']['dependencies']
        checkouts = {d['packageRef']['identity']: d['packageRef']['location']
                     for d in dependencies if d['state']['name'] == 'sourceControlCheckout'}
    if checkouts:
        raise SystemExit(f'Xcode resolved source-control packages: {sorted(checkouts)}')
print('The app uses the local Winnow package and no third-party package')
