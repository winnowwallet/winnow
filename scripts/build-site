#!/usr/bin/env python3
"""Generate the homepage and the focused app journey recording page."""
import argparse
import html
import json
import re
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TEST_PATH = "UITests/WinnowAppUITests.swift"
SOURCE = "https://github.com/winnowwallet/winnow/blob/main/"
VIDEO_PATH = "videos/wallet-journey.mp4"
# The recorded journey's checkpoints, in the order the run tells its story.
# load_journeys refuses any name here that the UI journey does not capture, so
# the homepage cannot show a screen no test produced.
ACTS = [
    ("An ordinary payment", [
        ("01-onboarding", "Create a wallet"),
        ("03-receive", "Show a receive address"),
        ("56-home-beginner", "The coins arrive"),
        ("06-send-review", "Check address, fee, total"),
        ("08-send-confirmed", "Confirmed on Bitcoin"),
        ("09-home-after-send", "History keeps the receipt"),
    ]),
    ("Two devices, one signature", [
        ("35-extra-device-policy", "Both keys required"),
        ("36-extra-device-review", "Review the payment"),
        ("37-extra-device-waiting", "Waiting for the second key"),
        ("39-extra-device-sent", "Both signed, sent"),
        ("40-extra-device-confirmed", "Confirmed"),
    ]),
    ("Shared savings, two of three", [
        ("26-savings-share", "Invite the other owners"),
        ("27-savings-funded", "Savings funded"),
        ("14-approval-waiting", "One approval so far"),
        ("15-approval-sent", "Two approve, it sends"),
        ("28-savings-confirmed", "Confirmed"),
    ]),
]
SHOT_WIDTH, SHOT_HEIGHT = 1206, 2622

def load_journeys(root):
    journeys = json.loads((root / "docs/journeys.json").read_text())
    source = (root / TEST_PATH).read_text()
    matches = list(re.finditer(r"^    func (test\d+\w+)\(", source, re.M))
    cases = {}
    for index, match in enumerate(matches):
        name = match.group(1)
        end = matches[index + 1].start() if index + 1 < len(matches) else len(source)
        cases[name] = (source.count("\n", 0, match.start()) + 1, source[match.start():end])
    seen, ids = set(), set()
    for journey in journeys:
        identity = journey["id"]
        if not re.fullmatch(r"[a-z][a-z0-9-]*", identity) or identity in ids:
            raise ValueError(f"duplicate or invalid journey id: {identity}")
        ids.add(identity)
        if journey["section"] not in {"everyday", "advanced"}:
            raise ValueError(f"{identity}: choose an everyday or advanced section")
        for test in journey["tests"]:
            if test not in cases:
                raise ValueError(f"{identity}: missing app test {test}")
            seen.add(test)
        if image := journey.get("image"):
            if not re.fullmatch(r"[a-z0-9-]+", image):
                raise ValueError(f"{identity}: invalid screenshot name")
            if not (root / f"docs/screenshots/{image}.png").is_file():
                raise ValueError(f"{identity}: missing screenshot {image}")
            if not any(f'"{image}", testCase: self' in cases[test][1] for test in journey["tests"]):
                raise ValueError(f"{identity}: screenshot was not captured by its app tests")
        if guide := journey.get("guide"):
            if not guide.startswith("/") or not (root / "docs" / (guide[1:] + ".html")).is_file():
                raise ValueError(f"{identity}: missing local guide {guide}")
    if unowned := set(cases) - seen:
        raise ValueError("app tests need a documented journey: " + ", ".join(sorted(unowned)))
    captured = set()
    for swift in sorted((root / "UITests").glob("*.swift")):
        captured.update(re.findall(r'Screenshots\.capture\(app, "([a-z0-9-]+)", testCase: self\)',
                                   swift.read_text()))
    listed = {name for _, shots in ACTS for name, _ in shots}
    if unproven := listed - captured:
        raise ValueError("checkpoint is not captured by the journey: " + ", ".join(sorted(unproven)))
    for name in sorted(listed):
        if not (root / f"docs/screenshots/{name}.png").is_file():
            raise ValueError(f"missing checkpoint screenshot: {name}.png")
    video = root / "docs" / VIDEO_PATH
    if not video.is_file():
        raise ValueError(f"missing journey video: {VIDEO_PATH}")
    with video.open("rb") as recording:
        if recording.read(128).startswith(b"version https://git-lfs.github.com/spec/v1"):
            raise ValueError("journey video is an unresolved LFS pointer")
    return journeys, cases

def escape(value):
    return html.escape(value, quote=True)

def recorded_run():
    """Keep every proven capture available without making it the landing page."""
    acts = []
    for heading, shots in ACTS:
        frames = "".join(
            f'<li><figure><a href="screenshots/{name}.png">'
            f'<img src="screenshots/{name}.png" width="{SHOT_WIDTH}" height="{SHOT_HEIGHT}" '
            f'loading="lazy" decoding="async" alt="Winnow on iPhone: {escape(caption.lower())}."></a>'
            f'<figcaption>{escape(caption)}</figcaption></figure></li>'
            for name, caption in shots)
        acts.append(f'<h3>{escape(heading)}</h3>\n<ol class="filmstrip">{frames}</ol>')
    total = sum(len(shots) for _, shots in ACTS)
    return f'''<details class="screen-gallery" id="screens">
<summary><span>Explore all {total} screens</span><span class="disclosure-mark" aria-hidden="true">+</span></summary>
<div class="gallery-content">{"".join(acts)}</div></details>'''


def homepage(journeys, cases):
    title = "Winnow — Bitcoin, on your terms"
    intro = "A Bitcoin wallet for your iPhone. Pay from your phone, add a second key, or share a wallet."
    modes = [
        ("everyday", "Everyday", "You approve", "56-home-beginner", "Your everyday wallet", "One key. One decision.", "Receive, review, send. All from your phone.", "1 key · 1 signature", 1, 1),
        ("both", "Both keys", "2 of 2", "40-extra-device-confirmed", "Two keys, both required", "Two keys. One signature.", "Your phone and a second signer both approve.", "MuSig2 · 1 signature", 2, 2),
        ("shared", "Any two", "2 of 3", "28-savings-confirmed", "Shared savings", "Two approve. One can be away.", "Any two owners can approve a payment.", "2-of-3 · 2 signatures", 3, 2),
    ]
    choices, policies, screens = [], [], []
    for index, (key, name, rule, shot, caption, heading, description, technical, keys, needed) in enumerate(modes):
        choices.append(f'''<label class="mode-choice"><input type="radio" name="wallet-mode" id="mode-{key}" value="{key}" aria-controls="policy-{key} screen-{key}"{' checked' if index == 0 else ''}>
<span><b>{name}</b><small>{rule}</small></span></label>''')
        dots = ''.join(f'<i class="key-dot{" absent" if n >= needed else ""}">{"✓" if n < needed else "–"}</i>' for n in range(keys))
        policies.append(f'''<div class="policy mode-{key}" id="policy-{key}">
<div class="policy-diagram" aria-hidden="true">{dots}<span class="policy-line"></span><span class="policy-result">{needed}/{keys}</span></div>
<h2>{heading}</h2><p>{description}</p><a class="technical" href="/vaults">{technical} <span aria-hidden="true">↗</span></a></div>''')
        screens.append(f'''<figure class="wallet-screen mode-{key}" id="screen-{key}">
<a href="screenshots/{shot}.png" aria-label="Enlarge {caption.lower()}"><img src="screenshots/{shot}.png" width="{SHOT_WIDTH}" height="{SHOT_HEIGHT}" loading="{'eager' if index == 0 else 'lazy'}" {'fetchpriority="high"' if index == 0 else ''} decoding="async" alt="{caption} in the real Winnow app."></a>
<figcaption><span class="screen-number">0{index + 1} / 03</span>{caption}</figcaption></figure>''')
    return f'''<!doctype html>
<!-- Generated by scripts/build-site. -->
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{escape(title)}</title><meta name="description" content="{escape(intro)}">
<link rel="canonical" href="https://winnowwallet.com/">
<meta property="og:title" content="{escape(title)}"><meta property="og:description" content="{escape(intro)}">
<meta property="og:type" content="website"><meta property="og:image" content="https://winnowwallet.com/og.png">
<link rel="stylesheet" href="home.css"><script src="home.js" defer></script>
</head><body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header wrap"><a class="brand" href="/" aria-label="Winnow home"><span class="brand-icon" aria-hidden="true">₿</span> winnow</a>
<nav aria-label="Main"><a href="/architecture">How it works</a><a href="https://github.com/winnowwallet/winnow">GitHub <span aria-hidden="true">↗</span></a></nav></header>
<main id="main" class="wrap">
<section class="hero" aria-labelledby="hero-title">
<div class="hero-copy"><p class="eyebrow"><span></span> A BITCOIN WALLET FOR IPHONE</p>
<h1 id="hero-title">Your bitcoin.<br>Your choice<br><em>of control.</em></h1>
<p class="intro">Pay from your phone, add a second key,<br class="desktop-break"> or share a wallet.</p>
<div class="actions"><a class="download" href="https://apps.apple.com/app/id6801502501">Download for iPhone <span aria-hidden="true">↗</span></a><a class="watch" href="/recording" data-watch><span class="play-icon" aria-hidden="true">▶</span> Watch it work</a></div>
<p class="availability">Open source <span>·</span> Early access <span>·</span> <a href="https://testflight.apple.com/join/83djpNE7">TestFlight</a></p>
<fieldset class="mode-picker"><legend>Choose who signs</legend><div class="mode-options">{"".join(choices)}</div></fieldset>
<div class="policies" aria-live="polite">{"".join(policies)}</div></div>
<div class="product-stage"><div class="stage-heading"><span>THE ACTUAL APP</span><span class="stage-dot" aria-hidden="true"></span><span>RECORDED ON SIGNET</span></div>
<div class="wallet-screens">{"".join(screens)}</div>
<a class="stage-link" href="/recording" data-watch><span class="play-icon" aria-hidden="true">▶</span> See the full journey <span aria-hidden="true">↗</span></a></div>
</section>
<section class="proof" aria-labelledby="proof-title"><div class="proof-heading"><p class="eyebrow">SEE FOR YOURSELF</p><h2 id="proof-title">One wallet. Three ways to pay.</h2></div>
<div class="journey-path" aria-label="Recorded journey: ordinary send, MuSig2 receive and send, then 2-of-3 receive and send"><span><b>01</b> Everyday</span><i aria-hidden="true">→</i><span><b>02</b> Both keys</span><i aria-hidden="true">→</i><span><b>03</b> Any two</span></div>
<p class="provenance-note">Real payments on private signet. Shared accounts use Bitcoin Core cosigners. <a href="/recording">Recording &amp; source ↗</a></p>
{recorded_run()}</section>
</main>
<footer class="wrap"><p class="footer-brand">winnow<span>Your phone connects directly to Bitcoin.</span></p><nav aria-label="Footer"><a href="/vaults">Shared wallets</a><a href="/roadmap">Roadmap</a><a href="/privacy">Privacy</a></nav></footer>
<dialog id="journey-dialog" aria-labelledby="video-title"><div class="dialog-bar"><h2 id="video-title">The wallet, in action.</h2><form method="dialog"><button autofocus aria-label="Close recording">Close <span aria-hidden="true">×</span></button></form></div>
<video controls playsinline preload="none" poster="/screenshots/56-home-beginner.png" aria-label="Ordinary, MuSig2, and 2-of-3 payments in Winnow"><source src="/{VIDEO_PATH}" type="video/mp4"><a href="/{VIDEO_PATH}">Download the wallet journey recording</a>.</video>
<p>Private signet · Bitcoin Core cosigners · <a href="/recording">Recording provenance</a></p></dialog>
</body></html>
'''

def recording_page(root):
    manifest = root / "docs/journey-provenance.json"
    if manifest.exists():
        evidence = json.loads(manifest.read_text())
        source = escape(evidence["source_sha"])
        video = evidence["video"]
        details = f'''<p>This recording and its {len(evidence["screenshots"])} checkpoint screenshots come from <a href="{escape(evidence["run_url"])}">this successful CI run</a>.</p>
<p>Test: <code>{escape(evidence["test"])}</code>, {evidence["test_seconds"]:.3f} seconds. Source: <a href="{SOURCE.replace('/blob/main/', '/commit/')}{source}"><code>{source}</code></a>.</p>
<p>The full host recording is retained without cuts or speed changes. The browser copy is H.264, {video["width"]} × {video["height"]}, {video["duration_seconds"]:.3f} seconds, {video["bytes"]:,} bytes.</p>
<p><a href="/journey-provenance.json">Media checksums and original recording details</a>. The run’s app artifact contains the original recording, log, and result bundle. Those assertions establish success; the video illustrates the flow.</p>
<p>A website-only build can reuse this recording. Its source and run above remain the ones that produced the media. Other guide illustrations retain their <a href="{SOURCE}docs/screenshots/README.md">historical provenance</a>.</p>'''
    else:
        details = f'''<p>This is the reviewed repository reference recording, retained when a build has no fresh or cached journey media. It does not claim a new integration run.</p>
<p>Read its <a href="{SOURCE}docs/videos/README.md">recording provenance</a> and <a href="{SOURCE}docs/screenshots/README.md">screenshot provenance</a> for the tested source, date, and result.</p>'''
    return f'''<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Wallet journey — Winnow</title><link rel="stylesheet" href="/site.css">
<style>video{{display:block;width:min(100%,26rem);max-height:75vh;margin:1.5rem auto;border:1px solid var(--rule);border-radius:1rem;background:#111}}</style></head>
<body><a class="skip-link" href="#main">Skip to content</a>
<header class="topbar"><div class="bar"><a class="mark" href="/" aria-label="Winnow home">winnow</a><nav class="links" aria-label="Main"><a href="/architecture">How it works</a><a href="/vaults">Shared wallets</a><a href="https://github.com/winnowwallet/winnow">GitHub ↗</a></nav></div></header><main id="main"><p class="page-kicker">Recorded in the real app</p><h1>Wallet journey</h1>
<video controls playsinline preload="metadata" poster="/screenshots/56-home-beginner.png" aria-label="Ordinary and shared-account payments in Winnow">
<source src="/{VIDEO_PATH}" type="video/mp4">
<a href="/{VIDEO_PATH}">Download the wallet journey recording</a>.
</video>
<h2>Recording provenance</h2>{details}<p><a href="/archive">Historical recordings and notes</a></p></main><footer><div class="bar"><nav aria-label="Footer"><a href="/roadmap">Roadmap</a><a href="/privacy">Privacy</a><a href="/recording">Recording</a></nav></div></footer></body></html>
'''

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="fail if generated pages are stale")
    parser.add_argument("--root", type=Path, default=ROOT, help="repository or staging root")
    args = parser.parse_args()
    journeys, cases = load_journeys(args.root)
    pages = {"index.html": homepage(journeys, cases),
             "recording.html": recording_page(args.root)}
    for name, rendered in pages.items():
        output = args.root / "docs" / name
        if args.check:
            if not output.exists() or output.read_text() != rendered:
                raise SystemExit(f"{name} is stale; run scripts/build-site")
        else:
            output.write_text(rendered)
    print(f"Documented features: {len(journeys)}; UI test scenarios: {len(cases)}")

if __name__ == "__main__":
    main()
