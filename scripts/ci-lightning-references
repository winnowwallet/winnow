#!/usr/bin/env python3
"""Fetch the pinned external host harness and build independent reference peers."""
from pathlib import Path
import subprocess
import sys

REPOSITORY = 'https://github.com/posix4e/lightning-reference.git'
COMMIT = 'fdc74a49e1fb08110ca900a2c60a910715c7809d'


def run(*args, cwd=None, env=None):
    subprocess.run(args, cwd=cwd, env=env, check=True)


def checkout(directory, repository, commit):
    if not directory.exists():
        directory.mkdir(parents=True)
        run('git', 'init', '-q', str(directory))
        run('git', 'remote', 'add', 'origin', repository, cwd=directory)
        run('git', 'fetch', '--depth=1', 'origin', commit, cwd=directory)
        run('git', 'checkout', '--detach', 'FETCH_HEAD', cwd=directory)
    actual = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=directory, text=True).strip()
    if actual != commit:
        raise SystemExit(f'Wrong reference checkout: {directory}: {actual}')
    dirty = subprocess.check_output(['git', 'status', '--porcelain', '--untracked-files=all'],
                                    cwd=directory, text=True).strip()
    if dirty:
        raise SystemExit(f'Reference checkout has local changes: {directory}')


def main():
    if len(sys.argv) != 2:
        raise SystemExit('usage: ci-lightning-references <fresh reference build directory>')
    directory = Path(sys.argv[1]).resolve()
    directory.mkdir(parents=True, exist_ok=True)
    source = directory / 'reference-source'
    checkout(source, REPOSITORY, COMMIT)
    run(sys.executable, str(source / 'scripts/build-references'), str(directory))


if __name__ == '__main__':
    main()
