#!/bin/bash
# On a disposable macOS CI host, observe synthetic route-test destinations.
# Requires passwordless sudo for tcpdump; never prompts for a password.
set -euo pipefail
cd "$(dirname "$0")/.."
evidence="${1:?usage: check-route-packets <new evidence directory>}"
mkdir "$evidence"
evidence="$(cd "$evidence" && pwd)"
sudo -n true
capture_pid=""
capture_job=""
stop_capture() {
  if [ -n "$capture_pid" ]; then
    sudo -n kill -INT "$capture_pid"
    for _ in {1..50}; do
      if ! sudo -n kill -0 "$capture_pid" 2>/dev/null; then break; fi
      sleep 0.1
    done
    if sudo -n kill -0 "$capture_pid" 2>/dev/null; then
      sudo -n kill -TERM "$capture_pid"
    fi
    wait "$capture_job" || true
    capture_pid=""
  fi
}
trap stop_capture EXIT
capture() {
  # Signal tcpdump itself, not sudo's monitor process: sudo can suppress a
  # SIGINT from its own process group and leave a background capture running.
  sudo -n /bin/sh -c 'echo "$$" > "$1"; shift; exec "$@"' capture \
    "$evidence/$1.pid" /usr/sbin/tcpdump -i pktap,all -n -s 0 -U \
    -w "$evidence/$1.pcap" '(host 8.8.8.8 and port 38357) or port 53 or (host 127.0.0.1 and port 38358)' \
    > "$evidence/$1-capture.log" 2>&1 &
  capture_job=$!
  for _ in {1..50}; do
    if [ -s "$evidence/$1.pid" ]; then capture_pid=$(cat "$evidence/$1.pid"); fi
    if grep -q 'listening on' "$evidence/$1-capture.log"; then
      [[ "$capture_pid" =~ ^[0-9]+$ ]]
      return
    fi
    # The job is sudo, root once it has switched user: a signal check from
    # the runner's user is refused then, so ask ps whether it still runs.
    ps -p "$capture_job" > /dev/null
    sleep 0.1
  done
  echo 'Packet capture did not become ready' >&2
  exit 1
}
capture control
# Positive controls: one harmless UDP datagram to the synthetic destination
# port, and one DNS-shaped probe to loopback. No response is required.
python3 - <<'PY'
import socket, struct
with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
    sock.sendto(b'Winnow routing test', ('8.8.8.8', 38357))
    name = b''.join(bytes([len(p)]) + p for p in b'winnow-wallet-route-proof.winnowwallet.com'.split(b'.')) + b'\0'
    sock.sendto(struct.pack('!6H', 1, 256, 1, 0, 0, 0) + name + struct.pack('!2H', 1, 1), ('127.0.0.1', 53))
PY
sleep 1
stop_capture
sudo -n /usr/sbin/tcpdump -nn -A -r "$evidence/control.pcap" > "$evidence/control.txt" 2>&1
grep -q '8.8.8.8.38357' "$evidence/control.txt"
grep -q 'winnow-wallet-route-proof' "$evidence/control.txt"
capture routed
# macOS pktap writes no pcap header when nothing matches. A distinct loopback
# canary proves capture liveness and creates a readable file even when the
# routed destinations correctly emit zero packets.
python3 - <<'PY'
import socket
with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
    sock.sendto(b'Winnow capture canary', ('127.0.0.1', 38358))
PY
swift test --skip-build --filter 'RoutePacketTests|RoutedSeedTests|RoutingTests' \
  2>&1 | tee "$evidence/tests.log"
sleep 1
stop_capture
sudo -n /usr/sbin/tcpdump -nn -A -r "$evidence/routed.pcap" > "$evidence/routed.txt" 2>&1
grep -q 'Winnow capture canary' "$evidence/routed.txt"
if grep -Eq '8\.8\.8\.8\.38357|winnow-wallet-route-proof' "$evidence/routed.txt"; then
  echo 'Direct destination or DNS probe traffic escaped the proxy' >&2
  exit 1
fi
echo 'Positive controls observed; routed probes emitted zero direct destination or DNS packets.'
