#!/usr/bin/env python3
"""Set the Winnow app target's export compliance keys for a release build.

WINNOW_NONEXEMPT_ENCRYPTION is the account holder's reviewed answer
(docs/release/encryption-inventory.md):
PENDING (the default) removes the key, so App Store Connect asks its questions
for the build; YES keeps it and adds WINNOW_ENCRYPTION_COMPLIANCE_CODE when
Apple issued one; NO sets it to NO. Only the WinnowApp target changes.
"""
import os
from pathlib import Path
import re
import sys

KEY = 'INFOPLIST_KEY_ITSAppUsesNonExemptEncryption'
TARGET = '\n  WinnowApp:\n'


def declare(text, mode, code=None):
    head, rest = text.split(TARGET, 1)
    target, tail = re.split(r'\n(?=  [A-Za-z]+:\n)', rest, maxsplit=1)
    line = re.search(rf'\n(\s*){KEY}: YES', target)
    if not line:
        raise SystemExit('WinnowApp does not declare non-exempt encryption')
    indent = line.group(1)
    if mode == 'PENDING':
        replacement = ''
    elif mode == 'YES':
        replacement = f'\n{indent}{KEY}: YES'
        if code:
            replacement += f'\n{indent}INFOPLIST_KEY_ITSEncryptionExportComplianceCode: "{code}"'
    elif mode == 'NO':
        if code:
            raise SystemExit('NO cannot carry an export compliance code')
        replacement = f'\n{indent}{KEY}: NO'
    else:
        raise SystemExit('WINNOW_NONEXEMPT_ENCRYPTION must be PENDING, YES or NO')
    target = target[:line.start()] + replacement + target[line.end():]
    return head + TARGET + target + '\n' + tail


def main():
    path = Path(sys.argv[1])
    mode = os.environ.get('WINNOW_NONEXEMPT_ENCRYPTION') or 'PENDING'
    path.write_text(declare(path.read_text(), mode, os.environ.get('WINNOW_ENCRYPTION_COMPLIANCE_CODE') or None))
    print(f'Winnow export compliance: {mode}')


if __name__ == '__main__':
    main()
