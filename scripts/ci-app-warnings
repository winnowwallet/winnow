#!/bin/bash
# Reject warnings emitted by this repository's Sources/ during the release
# build of the app. Warnings from the pinned library and from SDK headers stay
# visible in the log but do not make this focused gate noisy — btc-swift runs
# the same gate over its own sources.
#
# The build is not repeated here: an iOS release build is expensive, so the
# workflow tees the build it already runs into a log and this reads it.
#
# Locally, build into a fresh derived-data path before trusting a pass. Xcode
# builds incrementally, so a file that is not recompiled emits no warning and a
# second run after a failing first reports clean without anything having been
# fixed. CI is safe from this because RUNNER_TEMP starts empty; a workstation
# is not.
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
LOG_PATH="${1:?usage: ci-app-warnings <xcodebuild-log>}"

python3 - "$ROOT" "$LOG_PATH" <<'PY'
import pathlib
import re
import sys

root = pathlib.Path(sys.argv[1]).resolve()
sources = root / "Sources"
warnings = []
pattern = re.compile(r"^(.*?):(\d+):(\d+): warning: (.*)$")

for line in pathlib.Path(sys.argv[2]).read_text(errors="replace").splitlines():
    match = pattern.match(line.strip())
    if not match:
        continue
    path = pathlib.Path(match.group(1))
    if not path.is_absolute():
        path = root / path
    try:
        path.resolve().relative_to(sources)
    except ValueError:
        continue
    if line not in warnings:
        warnings.append(line)

if warnings:
    for warning in warnings:
        print(f"::error title=Release app Swift warning::{warning}")
    raise SystemExit(f"release app build emitted {len(warnings)} warning(s)")

print("Release app build completed without first-party warnings")
PY
