#!/bin/bash
# Inspect the exact distribution package that the next step uploads.
set -euo pipefail
ipa="$1"
script_dir="$(cd "$(dirname "$0")" && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
ditto -x -k "$ipa" "$work"
shopt -s nullglob
apps=("$work"/Payload/*.app)
[[ ${#apps[@]} == 1 ]] || { echo 'Expected exactly one exported iPhone app' >&2; exit 1; }
"$script_dir/verify-signed-archive" "${apps[0]}" --distribution
"$script_dir/verify-release-e2e-exclusion" "${apps[0]}"
shasum -a 256 "$ipa" > "$ipa.verified.sha256"
