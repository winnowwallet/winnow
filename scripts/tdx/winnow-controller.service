[Unit]
Description=Winnow disposable macOS test worker controller
After=network-online.target libvirtd.service winnow-ci-network.service
Requires=winnow-ci-network.service
RequiresMountsFor=/data/OSX-KVM/winnow-ci-pool
[Service]
Type=simple
User=tdx2
Environment=PATH=/home/tdx2/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/tdx2/winnow-ci-controller
ExecStartPre=/usr/bin/sha256sum --check /data/OSX-KVM/winnow-ci-pool/base/SHA256SUMS
ExecStart=/usr/bin/python3 /home/tdx2/winnow-ci-controller/controller.py
Restart=on-failure
RestartSec=30
TimeoutStartSec=900
TimeoutStopSec=20
[Install]
WantedBy=multi-user.target
